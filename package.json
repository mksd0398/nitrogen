{
  "name": "@mksd0398/nitrogen",
  "version": "3.3.2",
  "description": "Scaffold, deploy and install a Shopify app on Firebase in one command. Cloud Functions, Firestore and Hosting; Polaris web components and App Bridge; TypeScript or JavaScript. No framework, no server. Not affiliated with or endorsed by Shopify.",
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-app-template",
    "shopify-app-starter",
    "shopify-firebase",
    "shopify-embedded-app",
    "firebase",
    "firebase-functions",
    "cloud-functions",
    "firestore",
    "firebase-hosting",
    "create-shopify-app",
    "shopify-app-scaffold",
    "shopify-cli",
    "app-bridge",
    "polaris",
    "polaris-web-components",
    "theme-app-extension",
    "shopify-oauth",
    "shopify-webhooks",
    "serverless",
    "typescript",
    "multi-tenant",
    "nitrogen"
  ],
  "homepage": "https://mksd0398.github.io/nitrogen/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mksd0398/nitrogen.git"
  },
  "license": "MIT",
  "author": "Mayank Khan Singh DeSouza <mayank@kloctechnologies.com>",
  "type": "module",
  "bin": {
    "nitrogen": "bin/create.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node -e \"process.env.NITROGEN_E2E='1';require('child_process').execSync('npm test',{stdio:'inherit'})\"",
    "build:reference": "node tools/build-reference.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "lib",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  }
}
