# functions/.env — plain configuration, deployed with the functions.
# The client secret does NOT belong here. It lives in Secret Manager:
#   firebase functions:secrets:set SHOPIFY_API_SECRET
# and, for the local emulator only, in functions/.secret.local:
#   SHOPIFY_API_SECRET=your-api-secret

# Shopify app (Partner Dashboard → App → Client credentials)
SHOPIFY_API_KEY=your-api-key
SCOPES=read_products
APP_URL=https://your-project-id.web.app

# Which shops may use the app. Empty = any shop that installs it (multi-tenant).
# One domain = that store only (single-tenant). Comma-separate for several.
ALLOWED_SHOPS=

# Must equal the "region" of every rewrite in firebase.json
APP_REGION=us-central1
